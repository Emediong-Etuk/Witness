{
  "name": "witness",
  "private": true,
  "version": "0.1.0",
  "description": "Witness: camera vitals that show their work. A Clean-Window Gate over the Presage SmartSpectra SDK.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:web": "npm run build:web -w @witness/desktop",
    "build:desktop": "npm run build -w @witness/desktop",
    "e2e:ui": "playwright test --trace off",
    "bench": "tsx tools/bench/src/cli.ts",
    "bench:add-clip": "tsx tools/bench/src/cli.ts add-clip",
    "bench:summary": "tsx tools/bench/src/cli.ts summary",
    "bench:estimate": "tsx tools/bench/src/cli.ts estimate",
    "bench:record": "tsx tools/bench/src/cli.ts record",
    "bench:replay": "tsx tools/bench/src/cli.ts replay",
    "bench:calibrate": "tsx tools/bench/src/cli.ts calibrate",
    "bench:report": "tsx tools/bench/src/cli.ts report",
    "egress": "tsx tools/egress-audit/src/cli.ts",
    "egress:matrix": "tsx tools/egress-audit/src/cli.ts matrix",
    "egress:report": "tsx tools/egress-audit/src/cli.ts report",
    "verify": "tsx tools/verify/src/cli.ts",
    "bench:docs": "tsx tools/bench/src/cli.ts docs",
    "lab": "tsx tools/lab-recorder/src/cli.ts",
    "build:site": "npm run build -w @witness/web",
    "lint:compliance": "vitest run tools/compliance"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.1.0",
    "vite": "8.3.5",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.14.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@2.16.4": true,
    "protobufjs@7.6.6": true
  }
}
